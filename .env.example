# Required for local or hosted deployment. Use a unique random value (32+ characters).
APP_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ENVIRONMENT=development
DATA_DIR=./runtime_data
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

# First administrator: used only when the auth database is empty.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=Workspace Administrator
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password

# Required to accept external API audit metadata at POST /api/monitor/ingest.
INGEST_SECRET=replace-with-a-separate-long-random-ingest-secret
